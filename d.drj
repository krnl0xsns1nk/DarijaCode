// =======================================
// DarijaCode malformed numeric literals
// =======================================

// ---------- Valid ----------

kteb(0);
kteb(1);
kteb(10);
kteb(123456);
kteb(1_000);
kteb(12_34_56);
kteb(0.5);
kteb(10.25);
kteb(1_000.500_250);

// ---------- Invalid: trailing underscore ----------

//kteb(1_);
//kteb(10_);
//kteb(123_);
//kteb(1_000_);

// ---------- Invalid: leading underscore ----------

kteb(_1);
kteb(_10);
kteb(_123);

// ---------- Invalid: consecutive underscores ----------

//kteb(1__2);
//kteb(12__34);
//kteb(1___2);
//kteb(10____20);

// ---------- Invalid: underscore before decimal ----------

kteb(1_.5);
kteb(10_.25);

// ---------- Invalid: underscore after decimal ----------

kteb(1._5);
kteb(10._25);

// ---------- Invalid: trailing decimal ----------

kteb(1.);
kteb(10.);
kteb(123.);

// ---------- Invalid: multiple decimal points ----------

kteb(1..2);
kteb(10..25);
kteb(1.2.3);
kteb(123...456);

// ---------- Invalid: underscore around decimal ----------

//kteb(1_._2);
kteb(1._2_3);
kteb(1_.2);

// ---------- Invalid: decimal starts with underscore ----------

kteb(._5);

// ---------- Invalid: only underscore ----------

kteb(_);

// ---------- Invalid: underscore between decimal points ----------

kteb(1._.2);

// ---------- Invalid: many weird combinations ----------

//kteb(1___.___2);
kteb(123_.);
kteb(123._);
kteb(123___.);
kteb(0__0);
kteb(0._0);
kteb(0_.0);
kteb(999_);
kteb(999__);
kteb(999..);
kteb(999...);

// ---------- Invalid: separated by spaces ----------

kteb(1 _ 2);
kteb(1 . 2);
kteb(1_ .2);
kteb(1 ._2);
